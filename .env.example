# Generate real values with: privasoc init   (never commit .env)
PRIVASOC_API_TOKEN=
PRIVASOC_HMAC_KEY=
PRIVASOC_VAULT_KEY=
PRIVASOC_DATA_DIR=./data
PRIVASOC_HOST=127.0.0.1
PRIVASOC_PORT=8000
# Local LLM (any OpenAI-compatible server: Ollama, llama.cpp, vLLM...)
PRIVASOC_LLM_LOCAL_URL=http://127.0.0.1:11434/v1
PRIVASOC_LLM_LOCAL_MODEL=
# Optional remote fallback (any OpenAI-compatible provider). Always behind pseudonymisation.
PRIVASOC_LLM_REMOTE_URL=
PRIVASOC_LLM_REMOTE_MODEL=
PRIVASOC_LLM_REMOTE_API_KEY=
