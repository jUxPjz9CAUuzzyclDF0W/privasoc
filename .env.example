# Generate secrets with: privasoc init   (never commit .env)
PRIVASOC_API_TOKEN=
PRIVASOC_HMAC_KEY=
PRIVASOC_VAULT_KEY=
PRIVASOC_DATA_DIR=./data
PRIVASOC_HOST=127.0.0.1
PRIVASOC_PORT=8000

# Vector binary: its VRL runtime is the parser sandbox (Windows: C:\path\to\vector.exe)
PRIVASOC_VECTOR_BIN=vector
PRIVASOC_VECTOR_DIR=./vector

# Local LLM (any OpenAI-compatible server: Ollama, llama.cpp, vLLM...)
PRIVASOC_LLM_LOCAL_URL=http://127.0.0.1:11434/v1
PRIVASOC_LLM_LOCAL_MODEL=qwen3:8b
# Reasoning ("thinking") is slow on small GPUs; off by default for the local model
PRIVASOC_LLM_LOCAL_THINK=false
# Per-call limits: a slow or looping model fails cleanly instead of hanging
PRIVASOC_LLM_TIMEOUT=300
PRIVASOC_LLM_MAX_TOKENS=2048

# Optional remote fallback (any OpenAI-compatible provider). Always behind pseudonymisation.
PRIVASOC_LLM_REMOTE_URL=
PRIVASOC_LLM_REMOTE_MODEL=
PRIVASOC_LLM_REMOTE_API_KEY=
PRIVASOC_AUTO_FALLBACK=false

# Parser generation loop (D27)
PRIVASOC_SAMPLE_SIZE=10
PRIVASOC_MAX_ATTEMPTS=5
# structured (regex + ECS mapping, default) or vrl (free-form)
PRIVASOC_PARSER_MODE=structured
# a parser covering at least this share of real lines may be proposed (rest stays quarantined)
PRIVASOC_MIN_COVERAGE=0.8
